{
  "name": "alexandrepereira-ts-ui-components",
  "version": "2.0.3",
  "description": "TypeScript Vue 3 UI Components Library with Storybook",
  "type": "module",
  "main": "./dist/ts-ui-components.umd.cjs",
  "module": "./dist/ts-ui-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ts-ui-components.js",
      "require": "./dist/ts-ui-components.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "ui-components",
    "component-library",
    "storybook"
  ],
  "author": "Alexandre Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrepereira/ts-ui-components.git"
  },
  "homepage": "https://github.com/alexandrepereira/ts-ui-components#readme",
  "bugs": {
    "url": "https://github.com/alexandrepereira/ts-ui-components/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/addon-interactions": "^7.6.0",
    "@storybook/addon-links": "^7.6.0",
    "@storybook/addon-onboarding": "^1.0.10",
    "@storybook/blocks": "^7.6.0",
    "@storybook/test": "^7.6.0",
    "@storybook/vue3": "^7.6.0",
    "@storybook/vue3-vite": "^7.6.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-vue": "^9.17.0",
    "pinia": "^2.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.6.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^1.8.25"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
